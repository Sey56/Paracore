<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>Paracore.Addin</AssemblyTitle>
    <AssemblyName>Paracore.Addin</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Company>Codarch</Company>
    <AssemblyVersion>4.8.1.0</AssemblyVersion>
    <FileVersion>4.8.1.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=Paracore</PathMap>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PublishSelfContained>false</PublishSelfContained>
    <Nullable>enable</Nullable>

    <!-- Trim: English resources only — see CoreScript.Engine.csproj. The add-in publishes the
         whole dependency closure, so the property must be set here too. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <ProjectCapability>Protobuf_Generator</ProjectCapability>
    <ProtoRoot>$(MSBuildProjectDirectory)\..\protos</ProtoRoot>

    <!-- Allow override via command line or environment -->

    <Platforms>AnyCPU;x64</Platforms>
    
    <!-- Quality Automation -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
 
  <!-- No AspNetCore here. The Add-in is now a pure gRPC client to the Paracore.Server Sidecar -->


  <!-- Remove image from default build -->
  <ItemGroup>
    <None Remove="Images\Dashboard.png" />
    <None Remove="Images\DashboardPro.png" />
    <None Remove="Images\na_icon.png" />
    <None Remove="Images\Paracore.png" />
    <None Remove="Images\ParacorePro.png" />
    <None Remove="Images\unknown_icon.png" />
    <None Remove="Images\vscode_icon.png" />
    <None Remove="Images\web_icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="8.0.0" />
  </ItemGroup>

  <!-- Revit API references -->
  <!-- Nuget Revit API references -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoreScript.Engine\CoreScript.Engine.csproj" />

    <!--
      ⚠⚠ HOST-PROVIDED PACK SDK — the second half of the PdfSharp argument below, and it matters
      more. `Paracore.PackSdk.dll` is the surface every specialist pack is written against: the
      generated configurator, the results window, the run host, parameter discovery. No code in
      this project uses it, and that is deliberate.

      WHY IT LIVES HERE AND NOT IN EACH PACK
      `Paracore.Shim.IsolatedLoadContext.Load` probes the add-in bundle folder FIRST (step 1)
      before the pack roots, so a DLL sitting beside `Paracore.Addin.dll` resolves for every pack
      by name. One copy, versioned with the engine, installed once. A copy per pack would drift:
      pack A built against SDK 1.2 and pack B against 1.4 would both load, and the process would
      get two copies of the SDK's CodeRunner cache.

      ⚠ DO NOT DELETE THIS AS "UNUSED PROJECT REFERENCE". Removing it breaks nothing at build
      time — every pack still compiles — and then every pack fails at runtime with
      `FileNotFoundException: Paracore.PackSdk`, which reads as "the pack is broken" rather than
      "the host is missing a file". `build-addin.ps1` gates on the DLL being present in the
      publish folder precisely so this cannot ship.
    -->
    <ProjectReference Include="..\Paracore.PackSdk\Paracore.PackSdk.csproj" />

    <ProjectReference Include="..\Paracore.Server\Paracore.Server.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Embedded resources -->
  <ItemGroup>
    <Resource Include="Images\Dashboard.png" />
    <Resource Include="Images\DashboardPro.png" />
    <Resource Include="Images\Paracore.png" />
    <Resource Include="Images\ParacorePro.png" />
    <Resource Include="Images\unknown_icon.png" />
    <Resource Include="Images\vscode_icon.png" />
    <Resource Include="Images\web_icon.png" />
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageReference Include="Grpc.Core.Api" Version="2.67.0" />
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    ═══════════════════════════════════════════════════════════════════════════════════════
    PDFsharp — HOST-PROVIDED RUNTIME CAPABILITY, NOT AN ADD-IN FEATURE
    ═══════════════════════════════════════════════════════════════════════════════════════
    No code in this project references PDFsharp, and that is deliberate. The reference is here
    for one reason: `dotnet publish` copies the whole package closure into the add-in folder,
    and the add-in folder is the RUNTIME ROOT that every pack resolves against.

    ⚠ WHY HERE AND NOT IN THE TAKEOFF PACK THAT USES IT
    The takeoff pack's `Schedules` command writes PDFs and the pack COMPILES against PDFsharp,
    but a pack cannot ship it: `dotnet build` on a LIBRARY project does not copy NuGet runtime
    assets to its output folder — only `dotnet publish` does — so a pack-local copy would have
    to be hand-wired with a fragile package-path glob. Provisioning it here costs one copy, in
    the one folder both load paths already probe:
      • Paracore.Shim.IsolatedLoadContext.Load probes the add-in bundle folder FIRST (step 1);
      • the engine's PackLoader shares the Default context, which resolves from that same folder.
    The side benefit is that it GENERALISES: any future pack that needs to emit a PDF gets the
    stack for free, instead of every pack re-inventing how to ship it.

    ⚠⚠ DO NOT DELETE THIS AS "UNUSED PACKAGE". It looks unreferenced to any code search, and
    removing it breaks nothing at build time — the pack still compiles, the add-in still
    publishes cleanly — and the Schedules button then dies on the user's first click with the
    tool apparently installed correctly. `build-addin.ps1` gates on `PdfSharp.dll` being present
    in the publish folder precisely so that this failure cannot ship.

    ⚠ Same version the Pro add-in shipped (6.2.0) so the PDF output is byte-for-byte unchanged.
    ⚠ `Microsoft.Extensions.Logging` and `System.Security.Cryptography.Pkcs` come with it
    transitively (PDFsharp's .nuspec declares exactly those two). Neither is in the add-in
    folder today, so neither needs to be referenced by hand — and neither should be.
    ═══════════════════════════════════════════════════════════════════════════════════════
  -->
  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.0" />
  </ItemGroup>

  <!-- Proto file for gRPC service -->
  <ItemGroup>
    <Protobuf Include="$(ProtoRoot)\corescript.proto" GrpcServices="Client" Link="Protos\corescript.proto" />
  </ItemGroup>

  <!-- Target to generate .addin file -->
  <Target Name="GenerateAddinFile" AfterTargets="Publish">
    <PropertyGroup>
      <AddinContent>
<![CDATA[<?xml version="1.0" encoding="utf-8"?>
<RevitAddIns>
  <AddIn Type="Application">
    <Name>Paracore</Name>
    <Assembly>Paracore\Paracore.Shim.dll</Assembly>
    <ClientId>B2A5D84E-F6C2-494E-874D-93BB6D7A524F</ClientId>
    <FullClassName>Paracore.Shim.ParacoreShim</FullClassName>
    <VendorId>RAP</VendorId>
    <VendorDescription>RAP Community</VendorDescription>
  </AddIn>
</RevitAddIns>]]>
      </AddinContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(PublishDir)\Paracore.Addin.addin" Lines="$(AddinContent)" Overwrite="true" Encoding="utf-8" />
  </Target>

  <!-- Finalize Deployment: Copy the Paracore.Server Sidecar to the Add-in output -->
  <!-- This ensures that the Zero-Prerequisite sidecar is bundled with the Add-in -->
  <Target Name="CopySidecarToOutput" AfterTargets="Build;Publish">
    <PropertyGroup>
      <SidecarProjectFile>$(MSBuildProjectDirectory)\..\Paracore.Server\Paracore.Server.csproj</SidecarProjectFile>
      <SidecarPublishTemp>$(MSBuildProjectDirectory)\..\Paracore.Server\obj\publish_temp</SidecarPublishTemp>
      <SidecarOutputDir>$(TargetDir)</SidecarOutputDir>
      <SidecarOutputDir Condition="'$(PublishDir)' != ''">$(PublishDir)</SidecarOutputDir>
    </PropertyGroup>

    <Message Text="[Paracore] Publishing and Bundling Sidecar from $(SidecarProjectFile)..." Importance="high" />

    <!-- Clean the staging folder first. `dotnet publish` overwrites but never removes, so a
         file that has dropped out of the dependency closure (a trimmed satellite, a renamed
         assembly) would otherwise linger here and keep being copied into the bundle forever. -->
    <RemoveDir Directories="$(SidecarPublishTemp)" />

    <!-- Build and Publish the sidecar project as self-contained win-x64 -->
    <!-- We use the dotnet CLI directly for maximum reliability across VS and CLI builds -->
    <Exec Command="dotnet publish &quot;$(SidecarProjectFile)&quot; -c $(Configuration) --self-contained false -o &quot;$(SidecarPublishTemp)&quot;" />

    <!-- Copy the published output (exe + all dependencies) to our addin output folder -->
    <ItemGroup>
      <SidecarFiles Include="$(SidecarPublishTemp)\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(SidecarFiles)" DestinationFolder="$(SidecarOutputDir)" />
    
    <Message Text="[Paracore] Sidecar bundled successfully to: $(SidecarOutputDir)" Importance="high" />
  </Target>

</Project>
