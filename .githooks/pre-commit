#!/bin/sh
#
# pre-commit — keep every copy of the Revit wire contract in step with the authority.
#
# WHY THIS IS A HOOK AND NOT A REMINDER
#   protos/corescript.proto is the ONE authority. Its other copies are a runtime copy
#   (corescript-vscode/proto/corescript.proto) and a generated corescript_pb2*.py checked
#   in by every engine-driving MCP repo. A stale copy fails SILENTLY: protobuf tolerates
#   missing fields, so the caller reads a default and behaves as if the answer were "no".
#   That is exactly how paracore-model and paracore-family sat three RPCs behind the
#   authority without anyone noticing — they were checked in, but not listed in
#   STUB_REPOS, so the gate never looked at them.
#
# WHAT IT DOES
#   Fast path — if the authority is not part of this commit, exit immediately. Costs
#               nothing on an ordinary commit.
#   Otherwise — run gen-protos.py --write, stage the copy that lives inside THIS repo,
#               prove it with --check, then name any sibling repo whose stub moved.
#
#   Sibling stubs cannot be staged from here: they are separate git repos and need their
#   own commit. The hook reports them; it does not pretend to commit them.
#
# BYPASS  git commit --no-verify
#
# See README.md in this directory for the one-time setup.

REPO_ROOT=$(git rev-parse --show-toplevel)
PY="$REPO_ROOT/rap-server/server/.venv/Scripts/python.exe"
TOOL="$REPO_ROOT/scripts/gen-protos.py"
AUTHORITY="protos/corescript.proto"
VSCODE_COPY="corescript-vscode/proto/corescript.proto"

# --- fast path: the authority is not being committed --------------------------------
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qx "$AUTHORITY"; then
    exit 0
fi

echo "pre-commit: $AUTHORITY changed - checking every copy of the wire contract"

# --- the tool needs grpcio-tools + protobuf, which only the rap-server venv has ------
if [ ! -f "$PY" ]; then
    echo "pre-commit: WARNING - no python at $PY"
    echo "pre-commit: could NOT verify the proto copies. Before pushing, run by hand:"
    echo "pre-commit:     <rap-server venv python> scripts/gen-protos.py --check"
    exit 0
fi

# --- sync ----------------------------------------------------------------------------
if ! "$PY" "$TOOL" --write; then
    echo "pre-commit: BLOCKED - gen-protos.py --write failed"
    exit 1
fi

# --- the VS Code copy is inside THIS repo, so it belongs in THIS commit --------------
if [ -n "$(git status --porcelain -- "$VSCODE_COPY")" ]; then
    git add "$VSCODE_COPY"
    echo "pre-commit: staged $VSCODE_COPY"
fi

# --- prove it, rather than trusting --write ------------------------------------------
if ! "$PY" "$TOOL" --check; then
    echo "pre-commit: BLOCKED - copies still disagree with the authority after --write"
    exit 1
fi

# --- name the sibling repos that need their own commit -------------------------------
touched=""
for r in paracore-gen paracore-forge paracore-takeoff paracore-model paracore-family; do
    sib="$REPO_ROOT/../$r"
    [ -d "$sib/.git" ] || continue
    if [ -n "$(git -C "$sib" status --porcelain corescript_pb2.py corescript_pb2.pyi corescript_pb2_grpc.py 2>/dev/null)" ]; then
        touched="$touched $r"
    fi
done

if [ -n "$touched" ]; then
    echo "pre-commit: updated stubs in:$touched"
    echo "pre-commit: those are SEPARATE repos - commit them on their own before pushing."
fi

exit 0
