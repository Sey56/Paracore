<UserControl x:Class="SH_Tools.Views.BottomSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SH_Tools.Views"
             xmlns:viewmodels="clr-namespace:SH_Tools.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:CadViewModel}"
             xmlns:converters="clr-namespace:SH_Tools.Converters" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Other content here -->

        <Border Background="#A9A9A9" Grid.Row="1">
            <StackPanel Margin="0, 5, 0, 0">
                <Button Content="Create Revit Elements" MinWidth="240" HorizontalAlignment="Center"
                        Command="{Binding CreateRevitElementsCommand}" 
                        FontSize="14" Margin="10,5,10,0" MinHeight="25"
                        Visibility="{Binding IsFirstLayerReady, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="click to create Revit elements" ToolTipService.InitialShowDelay="500"/>
                <Label Content="Effortlessly convert AutoCAD floor plans to Revit elements" FontSize="14" HorizontalAlignment="Center" Margin="10,0,10,10" FontFamily="Stylus BT" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
