<UserControl x:Class="SH_Tools.Views.PickLinkSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SH_Tools.Views"
             xmlns:converters="clr-namespace:SH_Tools.Converters" 
             xmlns:viewmodels="clr-namespace:SH_Tools.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:CadViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border BorderThickness="0" Padding="10, 0, 10, 0" Margin="0,10,0,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Ellipse Width="30" Height="30" Fill="LightGray" Grid.Column="0">
                <Ellipse.ToolTip>
                    <ToolTip Content="Step 1" />
                </Ellipse.ToolTip>
                <Ellipse.Effect>
                    <DropShadowEffect Color="Black" Direction="0" ShadowDepth="2" Opacity="0.5"/>
                </Ellipse.Effect>
                <Ellipse.LayoutTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Ellipse.LayoutTransform>
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="0"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <TextBlock Grid.Column="0" Text="1" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Black"/>

            <Button Grid.Column="1" Content="Link" Command="{Binding PickLinkInstanceCommand}" 
        Margin="10, 5, 5, 5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14"
        MinWidth="100" ToolTip="Select a linked Cad file" ToolTipService.InitialShowDelay="500" />


            <Label Grid.Column="2" Content="{Binding FilePath}" 
       HorizontalAlignment="Center" FontSize="12" 
       VerticalAlignment="Stretch" Margin="10,0,10,0"/>


            <Ellipse Width="30" Height="30" Fill="LightGray" Grid.Column="3">
                <Ellipse.ToolTip>
                    <ToolTip Content="Step 2" />
                </Ellipse.ToolTip>
                <Ellipse.Effect>
                    <DropShadowEffect Color="Black" Direction="0" ShadowDepth="2" Opacity="0.5"/>
                </Ellipse.Effect>
                <Ellipse.LayoutTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Ellipse.LayoutTransform>
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="0"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <TextBlock Grid.Column="3" Text="2" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Black"/>

            <ComboBox HorizontalContentAlignment="Center" VerticalAlignment="Center" Grid.Column="4" x:Name="MyComboBox" ItemsSource="{Binding LevelElements}" HorizontalAlignment="Stretch" MinWidth="100"
                      SelectedItem="{Binding SelectedBaseLevel}" IsEnabled="{Binding IsLinkInstancePicked}"
                      Height="25" ToolTip="Select a level" ToolTipService.InitialShowDelay="500" Margin="10, 0, 0, 0">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

        </Grid>
    </Border>
</UserControl>
