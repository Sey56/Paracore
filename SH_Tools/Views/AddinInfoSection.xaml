<UserControl x:Class="SH_Tools.Views.AddinInfoSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SH_Tools.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <StackPanel Background="#A9A9A9" Orientation="Horizontal" VerticalAlignment="Center" Height="50">
        <!-- Logo on the Left -->
        <Image Source="pack://application:,,,/SH_Tools;component/Images/SynCadLogo.png" Height="40" Margin="10,0,10,0"/>

        <!-- Title on the Right -->
        <Label Content="SynCad: Cad to Revit Automation" FontSize="20" FontFamily="Stylus BT" Foreground="White" VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
