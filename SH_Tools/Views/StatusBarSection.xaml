<UserControl x:Class="SH_Tools.Views.StatusBarSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SH_Tools.Views" xmlns:viewmodels="clr-namespace:SH_Tools.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:CadViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border Padding="10, 0, 10, 0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="100" Grid.Row="1" Background="DarkGray">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Style>
                </ScrollViewer.Resources>
                <StatusBar Background="LightGray">
                    <StatusBarItem>
                        <TextBlock Text="{Binding StatusBarMessage}" Foreground="Green"/>
                    </StatusBarItem>
                </StatusBar>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
