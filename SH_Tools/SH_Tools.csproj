    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Images\OffsetMaxLogo.png" />
    <None Remove="Images\OffsetMax_32x32.png" />
    <None Remove="Images\SynCadLogo.png" />
    <None Remove="Images\SynCad_32x32.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\OffsetMaxLogo.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\OffsetMax_32x32.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
